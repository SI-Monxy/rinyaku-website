---
// Instagram のアイコン（線画）。色は文字色（currentColor）に合わせる。
interface Props {
  size?: number;
}
const { size = 20 } = Astro.props;
---

<svg
  class="instagram-icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <rect x="3" y="3" width="18" height="18" rx="5"></rect>
  <circle cx="12" cy="12" r="4.2"></circle>
  <circle cx="17.4" cy="6.6" r="0.9" fill="currentColor" stroke="none"></circle>
</svg>
