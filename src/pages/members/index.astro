---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { memberSections } from '@/lib/data';
---

<BaseLayout title="メンバー" description="臨床薬剤学分野のメンバー紹介">
  <section class="page-hero">
    <div class="container">
      <h1>メンバー</h1>
      <p>教員、大学院生、学部生がそれぞれの専門性を持ち寄り、研究に取り組んでいます。</p>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container">
      {
        memberSections.map((group) => (
          <div class="member-group">
            <h2>{group.title}</h2>
            <div class="member-list">
              {group.items.map((m) => (
                <article class="member-card">
                  {m.role ? <span class="role">{m.role}</span> : null}
                  <div class="name">
                    {m.profileUrl ? (
                      <a href={m.profileUrl} target="_blank" rel="noreferrer">
                        {m.name}
                      </a>
                    ) : (
                      m.name
                    )}
                  </div>
                  {m.nameEn ? <div class="en">{m.nameEn}</div> : null}
                  {m.degree ? <div class="note">{m.degree}</div> : null}
                </article>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
