---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { trainingFiles, trainingIntro } from '@/lib/data';
---

<BaseLayout title="実務実習関連" description="実務実習に必要なファイルのダウンロード">
  <section class="page-hero">
    <div class="container">
      <h1>実務実習関連</h1>
      {trainingIntro && <p>{trainingIntro}</p>}
    </div>
  </section>
  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="panel">
        <ul class="list-plain">
          {
            trainingFiles.map((file) => (
              <li class="news-item">
                <a href={file.file} download>
                  {file.title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
