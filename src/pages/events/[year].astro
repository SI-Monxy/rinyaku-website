---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('events');

  // 同じ年度が複数あると、エラーにならず片方のページが上書きされて消えるため、ビルドを止める
  const byYear = new Map<number, typeof items>();
  for (const item of items) byYear.set(item.data.year, [...(byYear.get(item.data.year) ?? []), item]);
  const duplicates = [...byYear].filter(([, list]) => list.length > 1);
  if (duplicates.length > 0) {
    const lines = duplicates.map(([year, list]) => `  - ${year}年度: ${list.map((i) => `src/content/events/${i.id}.md`).join(', ')}`);
    throw new Error(`同じ年度の行事が複数あります（Pages CMS でどちらかを削除するか、年度を修正してください）\n${lines.join('\n')}`);
  }

  return items.map((item) => ({
    params: { year: String(item.data.year) },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<BaseLayout title={item.data.title} description={item.data.description}>
  <section class="page-hero">
    <div class="container">
      <p class="note"><a href="/events/">行事</a> / {item.data.title}</p>
      <h1>{item.data.title}</h1>
      <p>{item.data.description}</p>
    </div>
  </section>
  <section class="section" style="padding-top:0">
    <div class="container">
      <article class="prose">
        <Content />
      </article>
    </div>
  </section>
</BaseLayout>
