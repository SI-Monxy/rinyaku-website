---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from 'astro:content';

const items = (await getCollection('activities')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="活動内容" description="研究室ゼミや研修会などの活動紹介">
  <section class="page-hero">
    <div class="container">
      <h1>活動内容</h1>
      <p>研究室では以下のような活動を行っています。</p>
    </div>
  </section>
  <section class="section" style="padding-top:0">
    <div class="container grid-2">
      {
        items.map((item) => (
          <a class="topic-link panel" href={`/activities/${item.id}/`}>
            <div>
              <h3>{item.data.title}</h3>
              <p>{item.data.description}</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
